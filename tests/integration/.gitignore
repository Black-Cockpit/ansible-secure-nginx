# Output of a harness run. All of it is regenerated by the next run and none
# of it describes the collection, so none of it is committed.

# Per-entry SSH parameters, written by run.sh from `vagrant ssh-config` and
# consumed by ansible-playbook through --ssh-common-args. They name a port
# and a private key path that are valid only for the VM that produced them.
reports/
*.ssh_config

# Target for `ansible-galaxy collection install -p ./collections`. ansible.cfg
# sets no collections_path, because the roles use builtin modules only, so
# this directory exists only when someone has pinned a collection by hand for
# a run. It is ignored so that experiment never reaches a commit.
collections/
